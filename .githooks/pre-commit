#!/bin/sh
# Scan staged changes for secrets with gitleaks (default ruleset). Fails closed if gitleaks is missing.
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
	exit 1
fi
exec gitleaks git --pre-commit --staged --redact --verbose --no-banner --log-level warn --config .gitleaks.toml
